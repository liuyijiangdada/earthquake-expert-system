    {
      "id": "em_earthquake_basics",
      "title": "地震基本知识",
      "category": "科普知识",
      "source": "综编自中国地震局科普资料",
      "phase_tag": "震前",
      "temporal_validity": "长期",
      "steps": [
        {
          "order": 1,
          "text": "地震是地壳快速释放能量产生的振动，震级每增加1级，能量约增加32倍。"
        },
        {
          "order": 2,
          "text": "震级衡量地震本身大小，烈度衡量地面受影响程度；同一次地震只有一个震级，但不同地点烈度不同。"
        },
        {
          "order": 3,
          "text": "浅源地震（深度<70km）破坏力通常更大，中源（70-300km）和深源（>300km）影响相对较小。"
        }
      ]
    },
