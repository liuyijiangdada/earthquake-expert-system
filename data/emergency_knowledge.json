          "text": "近海强震或收到海啸预警时，立即向高地或内陆撤离，勿观潮。"
        },
        {
          "order": 2,
          "text": "远离港口、海滩与河口，听从警报与当地政府指令。"
        },
        {
          "order": 3,
          "text": "海啸可能多波次到来，确认官方解除警报前勿返回低洼岸线。"
        }
      ]
    },
    {
      "id": "em_landslide",
      "title": "山区滑坡崩塌风险规避",
      "category": "次生灾害",
      "source": "综编自自然资源与应急管理公开提示",
      "phase_tag": "震后",
      "temporal_validity": "永久",
      "steps": [
