      "phase_tag": "震后",
      "temporal_validity": "长期",
      "steps": [
        {
          "order": 1,
          "text": "非专业人员勿进入危楼搜救，优先协助转运、登记与物资分发。"
        },
        {
          "order": 2,
          "text": "服从统一指挥，佩戴标识，注意自身防护与轮换休息。"
        },
        {
          "order": 3,
          "text": "发现伤员立即呼叫专业救援，不做超出能力的医疗处置。"
        }
      ]
    },
    {
