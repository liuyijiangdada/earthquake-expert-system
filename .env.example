# 复制为 .env 并填入真实 Key（勿提交 .env 到 Git）

# 高德地图 Web 服务 Key（「Web服务」类型，非 JS API）
# 申请：https://console.amap.com/dev/key/app
AMAP_WEB_SERVICE_KEY=

# 登录用户库 PostgreSQL（与 docker-compose postgres 服务对齐）
DATABASE_URL=postgresql://earthquake:earthquake@localhost:5432/earthquake_qa
# AUTH_DEFAULT_ADMIN_USER=admin
# AUTH_DEFAULT_ADMIN_PASSWORD=admin
